# Orion — environment template.
#
# Copy to .env and fill in the values. Never commit .env; it is gitignored.
# Production secrets live in Cerulean Vault (KV v2) and are referenced as
# vault://<mount>/<path>#<KEY> by the stack that resolves them.
#
# Identity is Cerulean Authentik (OIDC); DNS, TLS and the public proxy are
# Cerulean and NPM Edge. This repo does not implement any of the three.

# API and UI port
ORION_HTTP_PORT=8080

# API base used by the UI
ORION_API=http://127.0.0.1:8080

# Public origin
ORION_PUBLIC_URL=https://orion.innotel.us

# Cerulean Authentik issuer
OIDC_ISSUER_URL=https://auth.cerulean.innotel.us/application/o/orion/

# Cerulean OIDC client id
OIDC_CLIENT_ID=orion

# Cerulean OIDC client secret
OIDC_CLIENT_SECRET=change-me

# oauth2-proxy cookie secret
OIDC_COOKIE_SECRET=change-me

# oauth2-proxy bind address
ORION_SSO_BIND=127.0.0.1

# oauth2-proxy port
ORION_SSO_PORT=4180
