{
  "name": "orion",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "description": "Orion — a clean, robust, plug-and-play NAS desktop reconstructed from the ZimaOS workspace.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty",
    "test:dom": "node scripts/smoke-dom.mjs",
    "test:layout": "node scripts/smoke-layout.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
