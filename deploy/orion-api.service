[Unit]
Description=Orion API — files, storage and system facts for the desktop
Documentation=https://orion.locker/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/orion/orion-api.py
Environment=ORION_ROOT=/srv/storage
Environment=ORION_BIND=127.0.0.1
Environment=ORION_PORT=8099
# The OIDC client, the session secret and the groups allowed in. Optional on
# purpose: without the file the API still serves the machine and leans on the
# edge proxy's headers for nas.innotel.us, and only /auth/start says it cannot
# sign anyone in.
EnvironmentFile=-/etc/orion/api.env
# Subscriptions. The secret this machine accepts paid orders with is in the
# env file above, not here; with no secret the order intake answers 503 and
# says so rather than provisioning anything for free.
Environment=ORION_PROVISION_SCRIPT=/opt/orion/provision-container.sh
# The incus host the provisioned containers live on, and the client config that
# holds this machine's certificate for it. Both are read by
# provision-container.sh, which is the only thing that talks to incus.
Environment=ORION_INCUS_REMOTE=i1
Environment=INCUS_CONF=/etc/orion/incus/config
Restart=always
RestartSec=2
# The file operations write the data volume; service control calls systemctl.
User=root
ProtectHome=true
ProtectSystem=strict
# /srv/storage is the queue and the provisioner's scratch space; the incus
# client writes its cached server certificate beside its own certificate.
ReadWritePaths=/srv/storage /etc/orion/incus
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
